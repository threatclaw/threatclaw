[Unit]
Description=ThreatClaw Cybersecurity Agent
Documentation=https://github.com/threatclaw/threatclaw
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/threatclaw/docker
EnvironmentFile=/opt/threatclaw/.env
ExecStartPre=/usr/bin/docker compose --env-file /opt/threatclaw/.env pull --ignore-pull-failures
ExecStart=/usr/bin/docker compose --env-file /opt/threatclaw/.env up -d
ExecStop=/usr/bin/docker compose --env-file /opt/threatclaw/.env down
ExecReload=/usr/bin/docker compose --env-file /opt/threatclaw/.env up -d --force-recreate
TimeoutStartSec=300
TimeoutStopSec=120

# Hardening. The unit only invokes `docker compose`; these directives shrink the
# blast radius without blocking it. ProtectSystem=full keeps /usr,/boot,/etc
# read-only while leaving /opt and /var writable; ProtectHome=read-only still
# allows reading registry creds. Kept conservative so the compose wrapper (which
# talks to the docker socket and pulls images) is not broken.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectControlGroups=yes
RestrictSUIDSGID=yes

# Restart policy — restart after 30s if the oneshot fails
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
